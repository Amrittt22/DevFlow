{
  "name": "devflow-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run prisma7:generate && tsx watch src/server.ts",
    "build": "npm run prisma7:generate && tsc",
    "prisma7:generate": "prisma7 generate",
    "test": "vitest run",
    "test:unit": "vitest run src/modules",
    "test:integration": "vitest run src/test/integration",
    "prisma7:test:migrate": "prisma7 migrate deploy --config prisma7.test.config.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@prisma/prisma7": "^7.10.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "prisma": "^8.0.0-rc.23",
    "supertest": "^7.1.4",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "vitest": "^3.2.4"
  }
}
